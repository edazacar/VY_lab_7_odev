
#include <stdio.h>
#include <stdlib.h>

/* Hazine Agaci Oyunu */

typedef struct Node {
    int data;
    struct Node* left;
    struct Node* right;
} Node;

Node* insert(Node* root, int sayi) {
    if (root == NULL) {
        Node* newNode = malloc(sizeof(Node));
        newNode->data = sayi;
        newNode->left = NULL;
        newNode->right = NULL;
        return newNode;
    }

    if (sayi < root->data)
        root->left = insert(root->left, sayi);
    else if (sayi > root->data)
        root->right = insert(root->right, sayi);

    return root;
}

int search(Node* root, int sayi) {
    if (root == NULL)
        return 0;

    printf("Ziyaret edilen dugum: %d\n", root->data);

    if (root->data == sayi)
        return 1;

    if (sayi < root->data)
        return search(root->left, sayi);
    else
        return search(root->right, sayi);
}

int height(Node* root) {
    if (root == NULL)
        return 0;

    int sol = height(root->left);
    int sag = height(root->right);

    if (sol > sag)
        return sol + 1;
    else
        return sag + 1;
}

int main() {
    Node* root = NULL;
    int sayi;

    root = insert(root, 50);
    root = insert(root, 30);
    root = insert(root, 70);
    root = insert(root, 20);
    root = insert(root, 40);
    root = insert(root, 60);
    root = insert(root, 80);

    printf("Hazine Agaci Oyununa Hos Geldiniz!\n");
    printf("Bir sayi giriniz: ");
    scanf("%d", &sayi);

    if (search(root, sayi) == 1)
        printf("Hazine bulundu!\n");
    else
        printf("Bosuna kazdin!\n");

    printf("En kotu durumda adim sayisi: %d\n", height(root));

    return 0;
}
